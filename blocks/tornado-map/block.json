{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "stormchases/tornado-map",
    "title": "Tornado Map",
    "category": "stormchases",
    "icon": "location-alt",
    "description": "Interactive map of tornadoes with clickable details, plus optional memorable-storm and hurricane point overlays — block equivalent of [sc_tornado_map].",
    "textdomain": "stormchases",
    "attributes": {
        "year": {
            "type": "string",
            "default": ""
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "showHeading": {
            "type": "boolean",
            "default": true
        },
        "height": {
            "type": "number",
            "default": 500
        },
        "ratings": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": ["ef5", "ef4", "ef3", "ef2", "ef1", "ef0", "unrated"]
        },
        "showStorms": {
            "type": "boolean",
            "default": true
        },
        "showHurricanes": {
            "type": "boolean",
            "default": true
        },
        "showSnowfall": {
            "type": "boolean",
            "default": true
        },
        "showLegend": {
            "type": "boolean",
            "default": true
        },
        "showLayerToggles": {
            "type": "boolean",
            "default": false
        },
        "zoom": {
            "type": "number",
            "default": 0
        },
        "centerLat": {
            "type": "number",
            "default": 39.8283
        },
        "centerLon": {
            "type": "number",
            "default": -98.5795
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "stormchases-tornado-map-editor",
    "render": "file:./render.php"
}
