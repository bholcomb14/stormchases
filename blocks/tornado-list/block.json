{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "stormchases/tornado-list",
    "title": "Tornado List",
    "category": "stormchases",
    "icon": "list-view",
    "description": "Plain list of tornadoes with name, date, location, and EF rating — block equivalent of [scstats tornadoes=\"true\"].",
    "textdomain": "stormchases",
    "attributes": {
        "year": {
            "type": "string",
            "default": ""
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "showHeading": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "stormchases-tornado-list-editor",
    "render": "file:./render.php"
}
